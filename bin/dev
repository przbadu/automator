#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
BACKEND_DIR="$ROOT_DIR/backend"
FRONTEND_DIR="$ROOT_DIR/frontend"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

log()  { echo -e "${GREEN}[dev]${NC} $1"; }
warn() { echo -e "${YELLOW}[dev]${NC} $1"; }
err()  { echo -e "${RED}[dev]${NC} $1" >&2; }

cleanup() {
  log "Shutting down..."
  kill $(jobs -p) 2>/dev/null || true
  wait 2>/dev/null || true
  log "Done."
}
trap cleanup EXIT INT TERM

# --- Pre-flight checks ---

if [ ! -f "$ROOT_DIR/.env" ]; then
  err ".env file not found. Copy .env.example and fill in values:"
  err "  cp .env.example .env"
  exit 1
fi

# Check for uv
if ! command -v uv &>/dev/null; then
  err "uv not found. Install it: https://docs.astral.sh/uv/getting-started/installation/"
  exit 1
fi

# Check for node/npm
if ! command -v node &>/dev/null; then
  err "node not found. Install Node.js: https://nodejs.org/"
  exit 1
fi

# --- Backend setup ---

log "Setting up Python backend..."

cd "$BACKEND_DIR"

log "Installing Python dependencies..."
uv sync --quiet

# --- Frontend setup ---

log "Setting up frontend..."

cd "$FRONTEND_DIR"

if [ ! -d "node_modules" ]; then
  log "Installing npm dependencies..."
  npm install
else
  # Quick check if package.json changed
  if [ "package.json" -nt "node_modules/.package-lock.json" ] 2>/dev/null; then
    log "package.json changed, updating dependencies..."
    npm install
  fi
fi

# --- Kill old servers ---

if lsof -ti :8000 &>/dev/null; then
  warn "Killing existing process on port 8000..."
  kill $(lsof -ti :8000) 2>/dev/null || true
  sleep 1
fi

if lsof -ti :5173 &>/dev/null; then
  warn "Killing existing process on port 5173..."
  kill $(lsof -ti :5173) 2>/dev/null || true
  sleep 1
fi

# --- Start servers ---

log "Starting backend (uvicorn --reload)..."
cd "$BACKEND_DIR"
uv run uvicorn app.main:app --reload --host 0.0.0.0 --port 8000 &

log "Starting frontend (vite dev)..."
cd "$FRONTEND_DIR"
npm run dev -- --host 0.0.0.0 --port 5173 &

echo ""
log "========================================="
log "  Backend:  http://0.0.0.0:8000"
log "  Frontend: http://0.0.0.0:5173"
log "  Health:   http://0.0.0.0:8000/health"
log "========================================="
echo ""

wait

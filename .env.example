# Frontend (VITE_ prefix required for browser exposure)
VITE_API_URL=http://0.0.0.0:8000

# Langfuse
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://192.168.1.152:3000

# JWT
JWT_SECRET=              # openssl rand -hex 32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Embeddings (OpenAI-compatible)
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=nomic-embed-text
# EMBEDDING_DIMENSIONS=768  # Optional: set to truncate embeddings to specific dimension

# Document ingestion
CHUNK_SIZE=512
CHUNK_OVERLAP=50
UPLOAD_DIR=./uploads
CHROMA_DIR=./chroma_data
MAX_UPLOAD_SIZE_MB=50

# Hybrid search (BM25 + vector fusion)
HYBRID_SEARCH_ENABLED=true
RRF_K=60
RETRIEVAL_CANDIDATE_K=20
FINAL_TOP_K=5

# Relevance filtering (0.0 = disabled; only useful for vector-only mode, not hybrid/RRF)
# RETRIEVAL_RELEVANCE_THRESHOLD=0.0

# Reranker (cross-encoder API — enabled when both URL and model are set)
# RERANKER_BASE_URL=http://localhost:8001/v1
# RERANKER_MODEL=Qwen/Qwen3-Reranker-4B
# RERANKER_TOP_N=5

# Sub-agent (autonomous document analysis)
# SUB_AGENT_ENABLED=true
# SUB_AGENT_MAX_ITERATIONS=5
# SUB_AGENT_MAX_CHUNKS_PER_READ=20

# Text-to-SQL (query your data via natural language)
# TEXT_TO_SQL_ENABLED=true
# TEXT_TO_SQL_MAX_ROWS=50
# TEXT_TO_SQL_TIMEOUT_SECONDS=5

# Web Search (fallback when documents don't have the answer)
# WEB_SEARCH_ENABLED=false
# WEB_SEARCH_PROVIDER=searxng          # searxng | tavily | brave | exa
# WEB_SEARCH_URL=http://localhost:8888  # SearXNG instance URL
# WEB_SEARCH_API_KEY=                   # API key for Tavily/Brave
# WEB_SEARCH_MAX_RESULTS=5

# Encryption (auto-generated on first startup if empty)
ENCRYPTION_KEY=

# App
BACKEND_PORT=8000
FRONTEND_URL=http://0.0.0.0:5173
DATABASE_URL=sqlite:///./automator.db

# Frontend (VITE_ prefix required for browser exposure)
VITE_API_URL=http://0.0.0.0:8000

# LLM (OpenAI-compatible)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=no
LLM_MODEL=qwen3.5-2b

# Langfuse
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://192.168.1.152:3000

# JWT
JWT_SECRET=              # openssl rand -hex 32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# App
BACKEND_PORT=8000
FRONTEND_URL=http://0.0.0.0:5173
DATABASE_URL=sqlite:///./automator.db
